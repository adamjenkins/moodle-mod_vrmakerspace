{{!
    @template mod_vrsculpt/view

    The activity page: the user's sculpture with its versions and the studio link, and every sculpture
    for teachers, with their management links.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * startmodel - name of the starting model
    * workmode - individual or group work
    * hasconnection, connection - group work: how the members sculpt together
    * groupselector - rendered group selector HTML, or empty
    * cangrade, gradeurl - the grading page link
    * hassculpture, sculpture - the user's sculpture: sessionid, owner, status, isclosed, studiourl,
      hasversions, versions (version, savedby, timesaved, size, url, viewurl), hascontribution, contribution
    * nogroup - group work but the user is in no group
    * canviewall, canmanage, tracked, hasallsculptures, allsculptures - every sculpture (teachers):
      owner, versions, lastsaved, status, url, viewurl, contributions, managelinks (action, label, url)

    Example context (json):
    {
        "startmodel": "Clay lump",
        "workmode": "Individual",
        "hasconnection": false,
        "connection": "",
        "groupselector": "",
        "cangrade": true,
        "gradeurl": "#",
        "hassculpture": true,
        "sculpture": {
            "sessionid": 3,
            "owner": "Your sculpture",
            "status": "Open",
            "isclosed": false,
            "studiourl": "#",
            "hasversions": true,
            "versions": [
                {"version": 2, "savedby": "Sam Student", "timesaved": "Tuesday, 27 October 2026, 10:00 AM",
                 "size": "120.5 KB", "url": "#", "viewurl": "#"}
            ],
            "hascontribution": false,
            "contribution": ""
        },
        "nogroup": false,
        "canviewall": true,
        "canmanage": true,
        "tracked": false,
        "hasallsculptures": true,
        "allsculptures": [
            {"owner": "Sam Student", "versions": 2, "lastsaved": "Tuesday, 27 October 2026, 10:00 AM",
             "status": "Open", "url": "#", "viewurl": "#", "contributions": "",
             "managelinks": [{"action": "close", "label": "Close", "url": "#"}]}
        ]
    }
}}
<div class="mod_vrsculpt-view">
    <dl class="row mb-3">
        <dt class="col-sm-3">{{#str}} startmodel, mod_vrsculpt {{/str}}</dt>
        <dd class="col-sm-9">{{startmodel}}</dd>
        <dt class="col-sm-3">{{#str}} workmode, mod_vrsculpt {{/str}}</dt>
        <dd class="col-sm-9">{{workmode}}</dd>
        {{#hasconnection}}
            <dt class="col-sm-3">{{#str}} connection, mod_vrsculpt {{/str}}</dt>
            <dd class="col-sm-9">{{connection}}</dd>
        {{/hasconnection}}
    </dl>

    {{#cangrade}}
        <p><a class="btn btn-secondary" href="{{gradeurl}}">{{#str}} gradesculptures, mod_vrsculpt {{/str}}</a></p>
    {{/cangrade}}

    {{{groupselector}}}

    {{#nogroup}}
        <div class="alert alert-warning">{{#str}} nogroup, mod_vrsculpt {{/str}}</div>
    {{/nogroup}}

    {{#hassculpture}}
        {{#sculpture}}
            <section class="mb-4" aria-labelledby="mod_vrsculpt-mine-{{sessionid}}">
                <h3 id="mod_vrsculpt-mine-{{sessionid}}">{{owner}}</h3>
                <p>{{#str}} status, mod_vrsculpt {{/str}}: {{status}}</p>
                {{#isclosed}}
                    <div class="alert alert-info">{{#str}} sculptureclosed, mod_vrsculpt {{/str}}</div>
                {{/isclosed}}
                <p><a class="btn btn-primary" href="{{studiourl}}">{{#str}} openstudio, mod_vrsculpt {{/str}}</a></p>
                {{#hascontribution}}
                    <p>{{contribution}}</p>
                {{/hascontribution}}
                <h4>{{#str}} versionhistory, mod_vrsculpt {{/str}}</h4>
                {{#hasversions}}
                    <table class="table table-sm generaltable">
                        <thead>
                            <tr>
                                <th scope="col">{{#str}} version, mod_vrsculpt {{/str}}</th>
                                <th scope="col">{{#str}} savedby, mod_vrsculpt {{/str}}</th>
                                <th scope="col">{{#str}} timesaved, mod_vrsculpt {{/str}}</th>
                                <th scope="col">{{#str}} size {{/str}}</th>
                                <th scope="col">{{#str}} actions {{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#versions}}
                                <tr>
                                    <td>{{version}}</td>
                                    <td>{{savedby}}</td>
                                    <td>{{timesaved}}</td>
                                    <td>{{size}}</td>
                                    <td>
                                        <a href="{{viewurl}}">{{#str}} viewin3d, mod_vrsculpt {{/str}}</a>
                                        &middot;
                                        <a href="{{url}}">{{#str}} download {{/str}}</a>
                                    </td>
                                </tr>
                            {{/versions}}
                        </tbody>
                    </table>
                {{/hasversions}}
                {{^hasversions}}
                    <p>{{#str}} noversions, mod_vrsculpt {{/str}}</p>
                {{/hasversions}}
            </section>
        {{/sculpture}}
    {{/hassculpture}}

    {{#canviewall}}
        <section aria-labelledby="mod_vrsculpt-all">
            <h3 id="mod_vrsculpt-all">{{#str}} allsculptures, mod_vrsculpt {{/str}}</h3>
            {{#hasallsculptures}}
                <table class="table table-sm generaltable">
                    <thead>
                        <tr>
                            <th scope="col">{{#str}} owner, mod_vrsculpt {{/str}}</th>
                            <th scope="col">{{#str}} versions, mod_vrsculpt {{/str}}</th>
                            <th scope="col">{{#str}} lastsaved, mod_vrsculpt {{/str}}</th>
                            <th scope="col">{{#str}} status, mod_vrsculpt {{/str}}</th>
                            {{#tracked}}
                                <th scope="col">{{#str}} contributions, mod_vrsculpt {{/str}}</th>
                            {{/tracked}}
                            <th scope="col">{{#str}} actions {{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#allsculptures}}
                            <tr>
                                <td>{{owner}}</td>
                                <td>{{versions}}</td>
                                <td>{{lastsaved}}</td>
                                <td>{{status}}</td>
                                {{#tracked}}
                                    <td>{{contributions}}</td>
                                {{/tracked}}
                                <td>
                                    {{#viewurl}}
                                        <a class="me-2" href="{{viewurl}}">{{#str}} viewin3d, mod_vrsculpt {{/str}}</a>
                                    {{/viewurl}}
                                    {{#url}}
                                        <a class="me-2" href="{{url}}">{{#str}} download {{/str}}</a>
                                    {{/url}}
                                    {{#managelinks}}
                                        <a class="btn btn-secondary btn-sm me-1" href="{{url}}">{{label}}</a>
                                    {{/managelinks}}
                                </td>
                            </tr>
                        {{/allsculptures}}
                    </tbody>
                </table>
            {{/hasallsculptures}}
            {{^hasallsculptures}}
                <p>{{#str}} nosculptures, mod_vrsculpt {{/str}}</p>
            {{/hasallsculptures}}
        </section>
    {{/canviewall}}
</div>
